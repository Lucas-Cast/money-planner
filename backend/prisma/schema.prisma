generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  CDB
  BTC
  OTHER
}

model Goal {
  id                  Int          @id @default(autoincrement())
  title               String
  description         String
  targetDate          DateTime
  targetValue         Float
  monthlyContribution Float        @default(0)
  allocations         Allocation[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
}

model Allocation {
  id           Int       @id @default(autoincrement())
  goalId       Int
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  label        String
  type         AssetType
  amount       Float
  unitPrice    Float?
  yieldPercent Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([goalId])
}
